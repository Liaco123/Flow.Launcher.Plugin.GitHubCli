<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_githubcli_plugin_name">GitHub CLI</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_plugin_description">透過本機 gh CLI 搜尋儲存庫、組織、Pull Request 和近期熱門儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_repos">我的儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_repos_hint">列出目前 gh 帳號擁有的儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_orgs">我的組織</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_orgs_hint">列出目前 gh 帳號加入的組織；輸入組織名稱可查看其儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_prs">Pull Requests</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_prs_hint">搜尋儲存庫中的 Pull Request，或跨儲存庫搜尋</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_work">我的工作</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_work_hint">查看我建立的以及等待我審閱的 Pull Request</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_trend">GitHub Trend</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_trend_hint">查看近 1/7/30 天新建且目前 Star 較高的儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_unexpected_error">外掛處理查詢時發生非預期錯誤。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_open_github">在 GitHub 中開啟</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_copy_url">複製 URL</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_copy_identifier">複製識別名稱</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_switch_query">切換查詢</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_use_query">使用此查詢</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_org_repositories">查看此組織的儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_repo_prs">查看此儲存庫的 Pull Requests</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_stale_error">重新整理失敗，正在顯示快取結果</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_home_hint">按 Enter 返回 GitHub CLI 首頁</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_go_home">返回 GitHub CLI 首頁</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_stale_cache">舊快取</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_cache">快取</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_trend_daily">近 1 天新建</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_trend_monthly">近 30 天新建</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_trend_weekly">近 7 天新建</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_organization">GitHub 組織</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_repository">GitHub 儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_pull_request">GitHub Pull Request</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_draft">草稿</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_authored">我建立的</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_review_requested">等待我審閱</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_archived">已封存</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_review">審閱 {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_author">作者 {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_updated">更新於 {0}</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_forks">Fork {0:N0}</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_error_auth">GitHub CLI 尚未登入</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_error_command">GitHub CLI 查詢失敗</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_error_invalid_query">查詢格式無效</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_error_invalid_response">無法解析 GitHub CLI 回傳結果</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_error_unavailable">找不到 GitHub CLI</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_error_timeout">GitHub CLI 查詢逾時</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_fallback_auth">請先使用 gh auth login 登入 GitHub。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_fallback_command">gh 命令無法完成查詢。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_fallback_invalid_query">請修改查詢參數後重試。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_fallback_invalid_response">gh 回傳了外掛無法辨識的資料。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_fallback_unavailable">請安裝 GitHub CLI，並確保 gh.exe 位於 PATH 中。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_fallback_timeout">查詢超過等待時間。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_fallback_error">查詢無法完成。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_my_repos">找不到目前帳號擁有的儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_repos">找不到符合條件的儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_prs">找不到符合條件的 Pull Request</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_work">目前沒有待處理的 Pull Request</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_orgs">找不到符合條件的組織</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_org_repos">找不到此組織下符合條件的儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_trend">找不到符合條件的 Trend 儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_repo">找不到此儲存庫</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_pr">找不到此 Pull Request</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_empty_results">找不到結果</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_install_hint">按 Enter 開啟安裝頁面</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_install_page">開啟 GitHub CLI 安裝頁面</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_auth_hint">按 Enter 查看登入命令</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_auth_usage">查看 gh auth login 用法</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_invalid_hint">按 Enter 返回外掛首頁</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_retry_hint">按 Enter 重試</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_retry_query">重試查詢</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_invalid_home">home 命令不接受參數。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_invalid_direct_pr">PR 直達格式應為 owner/repo#編號，且編號必須大於 0。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_invalid_org">組織名稱只能包含字母、數字、點、底線或連字號。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_invalid_period">Trend 週期只能是 daily、weekly 或 monthly。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_invalid_language">程式語言參數不能為空。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_invalid_pr_number">PR 編號必須是大於 0 的整數。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_runner_start">無法啟動 GitHub CLI。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_runner_missing">找不到 gh.exe。請先安裝 GitHub CLI，並確保 gh 位於 PATH 中。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_runner_timeout">GitHub CLI 查詢超過 {0:0.#} 秒，已取消。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_invalid">查詢格式無效。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_response">gh 回傳了無法解析的資料。請重試或在終端機檢查 gh 命令輸出。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_unsupported">不支援的查詢類型。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_org_missing">組織儲存庫查詢缺少組織名稱。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_period_missing">Trend 查詢缺少時間週期。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_repo_missing">儲存庫直達查詢缺少 owner/repo。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_pr_missing">PR 直達查詢缺少有效的 owner/repo#編號。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_auth">gh 尚未登入。請先在終端機執行 gh auth login。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_service_exit">gh 查詢失敗，結束代碼為 {0}。</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_open">開啟</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_closed">已關閉</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_merged">已合併</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_public">公開</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_private">私人</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_internal">內部</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_approved">已核准</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_changes_requested">要求變更</system:String>
    <system:String x:Key="flowlauncher_plugin_githubcli_status_review_required">待審閱</system:String>
</ResourceDictionary>
